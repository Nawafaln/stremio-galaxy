#include <windows.h>
#include "src/resource.h"

#define IDR_MAINFRAME 101

IDR_MAINFRAME ICON "images/galaxy-icon.ico"

// Stremio Galaxy additions; original image resources retained.
#include "app_identity.h"
STRINGTABLE
BEGIN
    201 APP_NAME
END
IDR_GALAXY_BLACK_CSS RCDATA "assets/black-theme.css"
IDR_GALAXY_APPEARANCE_JS RCDATA "assets/appearance.js"
IDR_GALAXY_POSTER_HOVER_JS RCDATA "assets/poster-hover.js"
IDR_GALAXY_TOP_NAV_JS RCDATA "assets/top-navigation.js"
IDR_GALAXY_TOP_NAV_CSS RCDATA "assets/top-navigation.css"
IDR_GALAXY_DETAIL_BACKDROP_JS RCDATA "assets/detail-backdrop.js"
IDR_GALAXY_CACHE_JS RCDATA "assets/cache-settings.js"
IDR_GALAXY_CACHE_CSS RCDATA "assets/cache-settings.css"
IDR_GALAXY_UPDATE_JS RCDATA "assets/update-settings.js"
IDR_GALAXY_ACCOUNT_MENU_CSS RCDATA "assets/account-menu.css"
IDR_GALAXY_STARTUP_HTML RCDATA "assets/startup-logo/intro.html"
IDR_GALAXY_STARTUP_THREE RCDATA "assets/startup-logo/three.min.js"
IDR_GALAXY_STARTUP_HOST RCDATA "assets/startup-logo/intro.js"
IDR_GALAXY_STARTUP_LOGO RCDATA "assets/startup-logo/logo.webp"
IDR_GALAXY_WATCH_PARTY_JS RCDATA "assets/watch-party.js"
1 VERSIONINFO
 FILEVERSION 5,0,23,0
 PRODUCTVERSION 5,0,23,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "ProductName", APP_NAME "\0"
   VALUE "FileDescription", APP_NAME " community desktop shell\0"
   VALUE "InternalName", APP_NAME "\0"
   VALUE "OriginalFilename", APP_EXE "\0"
   VALUE "FileVersion", APP_VERSION "\0"
   VALUE "ProductVersion", APP_VERSION "\0"
   VALUE "LegalCopyright", APP_ATTRIBUTION "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

IDR_GALAXY_DETAIL_RAILS_JS RCDATA "assets/detail-rails.js"
IDR_GALAXY_DETAIL_RAILS_CSS RCDATA "assets/detail-rails.css"

IDR_GALAXY_LAYOUT_JS RCDATA "assets/galaxy-layout.js"
IDR_GALAXY_LAYOUT_CSS RCDATA "assets/galaxy-layout.css"

IDR_GALAXY_SETTINGS_DASHBOARD_JS RCDATA "assets/settings-dashboard.js"
IDR_GALAXY_SETTINGS_DASHBOARD_CSS RCDATA "assets/settings-dashboard.css"

